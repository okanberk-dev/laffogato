<?xml version="1.0" encoding="utf-8"?>
<!-- Windows tile: the app icon on the house green (--bg-espresso #1d6d56,
     the app's bg.inverse). brand-theme.test.ts reads this file, so a tile
     left on a retired palette fails there. -->
<browserconfig>
  <msapplication>
    <tile>
      <square150x150logo src="/brand/app-icon-192.png"/>
      <TileColor>#1d6d56</TileColor>
    </tile>
  </msapplication>
</browserconfig>
