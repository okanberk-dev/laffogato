{
  "name": "laffogato",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:bundle": "node scripts/db-bundle.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "legal:export": "node scripts/legal-export.mjs",
    "email:build": "node scripts/build-email-templates.mjs",
    "prebuild": "node scripts/build-email-templates.mjs",
    "predev": "node scripts/build-email-templates.mjs"
  },
  "dependencies": {
    "@internationalized/date": "3.12.4",
    "@next/third-parties": "^16.3.6",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.1",
    "bcryptjs": "^3.0.3",
    "jsqr": "^1.4.0",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "otplib": "^13.5.0",
    "parse5": "8.0.1",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-aria-components": "1.21.1",
    "react-dom": "19.2.4",
    "sharp": "0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^24.13.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
