# ============================================================================
# Local geliştirme için bu dosyayı `.env.local` olarak kopyalayın ve doldurun.
#
# Vercel deploy için: bütün değişkenleri Vercel dashboard → Settings →
# Environment Variables üzerinden ekleyin. `NEXT_PUBLIC_*` olanlar otomatik
# olarak client'a expose edilir; diğerleri sadece sunucu tarafında okunur.
#
# Vercel'in kendisi otomatik olarak set ettiği değişkenler (set ETMEYİN):
#   - VERCEL=1, VERCEL_ENV (production|preview|development)
#   - VERCEL_URL (her deploy için unique)
#   - VERCEL_PROJECT_PRODUCTION_URL (production canonical domain)
#   - NODE_ENV (production)
# ============================================================================

# ----------------------------------------------------------------------------
# Veritabanı (Neon — serverless Postgres)
# Neon panelinden ya da Vercel'deki Neon entegrasyonundan alınan connection
# string. Sunucu tarafı bu tek değişkenle bağlanır; tüm veri erişimi
# "server-only" — bu değer ASLA NEXT_PUBLIC_ ile expose edilmez.
#
# Pooled (`-pooler`) endpoint'i kullan: serverless fonksiyonlar için doğrusu o.
# Şema `npm run db:migrate` ile kurulur.
#
# POSTGRES_URL / NEON_DATABASE_URL fallback olarak da okunur (Vercel entegrasyonu
# bunları otomatik set edebilir).
# ----------------------------------------------------------------------------
DATABASE_URL=

# ----------------------------------------------------------------------------
# Site
# Production: gerçek custom domain (ör. https://laffogato.com.tr).
# Vercel preview deploylarında bunu set ETMEYİN — kod otomatik olarak
# VERCEL_URL / VERCEL_PROJECT_PRODUCTION_URL'a düşer.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# SEO — Search engine verification tokens (opsiyonel)
# Set edilirse layout.tsx ilgili <meta> etiketini emit eder.
# ----------------------------------------------------------------------------
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# NEXT_PUBLIC_YANDEX_VERIFICATION=
# NEXT_PUBLIC_BING_VERIFICATION=
# NEXT_PUBLIC_PINTEREST_VERIFICATION=
# NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=

# ----------------------------------------------------------------------------
# Analytics / Marketing — Google Tag Manager (tüm tag'ler GTM'den yönetilir:
# GA4, Meta Pixel, dönüşümler, …). Boş bırakılırsa GTM yüklenmez. Koddaki
# varsayılan container: GTM-KZ2QCHTT.
# ----------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=GTM-KZ2QCHTT

# ----------------------------------------------------------------------------
# Admin auth (env-credentialed)
# - ADMIN_SESSION_SECRET: signed cookie için en az 32 karakterlik rastgele bir dize.
# - ADMIN_EMAIL / ADMIN_PASSWORD: tek owner kullanıcısının kimlik bilgileri
#   (geriye uyumluluk için duruyor; rolü her zaman "owner" olur).
# - ADMIN_USERS: çok-kullanıcılı kurulum. JSON array:
#   '[{"email":"x@y.com","password":"…","role":"manager"}]'
#   Roller: "owner" (tümü) · "manager" (settings hariç) · "staff" (siparişler + stok).
# ----------------------------------------------------------------------------
ADMIN_SESSION_SECRET=replace-with-a-long-random-string
ADMIN_EMAIL=nextonmuzik@gmail.com
ADMIN_PASSWORD=replace-with-a-strong-password
# ADMIN_USERS=[{"email":"manager@laffogato.it","password":"…","role":"manager"}]

# ----------------------------------------------------------------------------
# Müşteri (üyelik) cookie imzası
# Set edilmezse ADMIN_SESSION_SECRET yedek olarak kullanılır.
# ----------------------------------------------------------------------------
CUSTOMER_SESSION_SECRET=

# ----------------------------------------------------------------------------
# Payment provider
# Olası değerler: mock | iyzico | paytr  (mock = geliştirme)
# Webhook secret, gelen webhook imzalarını doğrulamak için.
# ----------------------------------------------------------------------------
PAYMENT_PROVIDER=mock
PAYMENT_WEBHOOK_SECRET=replace-with-a-long-random-string

# Gerçek sağlayıcı eklenince doldurulacak:
# IYZICO_API_KEY=
# IYZICO_SECRET_KEY=
# IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# ----------------------------------------------------------------------------
# E-posta (müşteri e-posta doğrulaması). Resend ayarlıysa gerçek mail gider;
# ayarlı değilse doğrulama bağlantısı yalnızca sunucu loglarına yazılır.
# ----------------------------------------------------------------------------
# RESEND_API_KEY=
# EMAIL_FROM="L'Affogato <onboarding@resend.dev>"

# ----------------------------------------------------------------------------
# Seed / first admin
# ----------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
